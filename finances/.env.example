# Plaid production credentials (Plaid Dashboard > Team Settings > Keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Optional: stable id for the Link user
PLAID_CLIENT_USER_ID=fernando-personal

# Supabase (same values the other pipelines use). Optional for the link step;
# if omitted, the daily sync populates the account map on its first run.
SUPABASE_URL=
SUPABASE_KEY=
